# ==========================================
# WakeHarbor Backend Configuration Example
# ==========================================

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=wakeharbor
DB_USERNAME=postgres
DB_PASSWORD=postgres_secure_password
DB_SCHEMA=public

# Admin Bootstrap Credentials (Used to seed the initial single-admin user)
WAKEHARBOR_ADMIN_EMAIL=admin@wakeharbor.local
WAKEHARBOR_ADMIN_PASSWORD=ChangeThisToASecureAdminPassword123!

# Security & Encryption Secrets
# Master key for AES-256-GCM authenticated encryption of stored Supabase API keys (must be 32 bytes / 64 hex chars or 32+ char phrase)
WAKEHARBOR_ENCRYPTION_SECRET=4f8b2c1e9a3d7f6e5b4a3c2d1e0f9a8b7c6d5e4f3a2b1c0d9e8f7a6b5c4d3e2f
# JWT Secret for session authentication (HMAC-SHA256, minimum 256 bits / 32 characters)
WAKEHARBOR_JWT_SECRET=super_secret_jwt_signing_key_wakeharbor_secure_token_minimum_32_chars!

# Internal Machine-to-Machine Secret (Secures Worker to Control Service communication)
WAKEHARBOR_WORKER_SECRET=internal_worker_secret_wakeharbor_machine_token_489247291847129

# Service Ports & URLs
CONTROL_SERVICE_PORT=8080
WORKER_SERVICE_PORT=8081
CONTROL_SERVICE_INTERNAL_URL=http://localhost:8080

# CORS & Frontend Origins
FRONTEND_ORIGIN=http://localhost:3000

# Optional Notification (SMTP) Configuration (Leave empty to keep external email notifications disabled)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=alerts@wakeharbor.local
SMTP_STARTTLS=true
ALERT_RECIPIENT_EMAIL=admin@wakeharbor.local

# Job Scheduling & Heartbeat Worker Defaults
WAKEHARBOR_JOB_CLAIM_BATCH_SIZE=10
WAKEHARBOR_JOB_LEASE_SECONDS=300
WAKEHARBOR_WORKER_POLL_INTERVAL_MS=15000
WAKEHARBOR_WORKER_HEALTH_INTERVAL_MS=30000
WAKEHARBOR_REQUEST_TIMEOUT_SECONDS=10
